{
  "name": "novel-world-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first terminal harness for compiling novels into verifiable executable worlds.",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    }
  },
  "bin": {
    "nwh": "./dist/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && pnpm run build:server && pnpm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "dev": "node --import tsx src/cli.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:web:server": "pnpm run build:web && node --import tsx src/cli.ts web --no-open",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm run build && playwright test",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@fastify/static": "^10.1.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-virtual": "^3.14.10",
    "commander": "^15.0.0",
    "cytoscape": "^3.34.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typebox": "^1.3.12",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
