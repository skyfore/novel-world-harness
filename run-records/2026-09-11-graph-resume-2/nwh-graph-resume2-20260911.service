[Unit]
Description=Novel Harness graph adjudication continuation
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=root
WorkingDirectory=/root/workplace/novel-world-harness
ExecStart=/root/.nvm/versions/node/v22.19.0/bin/node --import tsx run-records/2026-09-11-graph-resume-2/resume.ts
